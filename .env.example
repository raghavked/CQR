# CQR Backend — Environment Variables
#
# API KEY POLICY:
#   CQR does NOT hold Anthropic or OpenAI API keys.
#   Users supply their own key per-request in the POST /api/tasks body:
#     { "api_key": "sk-...", "api_key_type": "anthropic" | "openai" }
#   Keys flow: POST /api/tasks → Orchestration → Agent Bridge → SDK client → destroyed.
#   They are never stored, never logged, and never written to disk.

# Postgres (shared by LSM layer and Orchestration persistence)
DATABASE_URL=postgresql://cqr:cqr@postgres:5432/cqr

# Redis (task queue)
REDIS_URL=redis://redis:6379

# Internal service URLs (Docker network names)
KG_ENGINE_URL=http://kg-engine:8001
LSM_LAYER_URL=http://lsm-layer:8002
EXECUTION_ENV_URL=http://execution-env:8003
VAULT_URL=http://vault:8004
AGENT_BRIDGE_URL=http://agent-bridge:8005
SECURITY_SCANNER_URL=http://security-scanner:8006

# Service ports
ORCHESTRATION_PORT=8000
KG_ENGINE_PORT=8001
LSM_LAYER_PORT=8002
EXECUTION_ENV_PORT=8003
VAULT_PORT=8004
AGENT_BRIDGE_PORT=8005
SECURITY_SCANNER_PORT=8006

# LLM model overrides (optional — defaults shown)
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CODEX_MODEL=gpt-4o
CODEX_MAX_TOKENS=4096

# Security
VAULT_IPC_TOKEN=generate_a_secure_random_token_here
