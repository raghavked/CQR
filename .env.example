# LLM APIs
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Postgres (LSM)
DATABASE_URL=postgresql://cqr:cqr@postgres:5432/cqr

# Redis (Task queue)
REDIS_URL=redis://redis:6379

# Internal Service URLs
KG_ENGINE_URL=http://kg-engine:8001
LSM_LAYER_URL=http://lsm-layer:8002
EXECUTION_ENV_URL=http://execution-env:8003
VAULT_URL=http://vault:8004
AGENT_BRIDGE_URL=http://agent-bridge:8005
SECURITY_SCANNER_URL=http://security-scanner:8006

# Service Ports
ORCHESTRATION_PORT=8000
KG_ENGINE_PORT=8001
LSM_LAYER_PORT=8002
EXECUTION_ENV_PORT=8003
VAULT_PORT=8004
AGENT_BRIDGE_PORT=8005
SECURITY_SCANNER_PORT=8006

# Security
VAULT_IPC_TOKEN=generate_a_secure_random_token_here
